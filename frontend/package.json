{
  "name": "maplegotchi-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/art/cli.mjs && vite",
    "build": "node tools/art/cli.mjs && tsc --noEmit && vite build && node tools/art/bundle.mjs",
    "typecheck": "node tools/art/cli.mjs && tsc --noEmit",
    "lint": "eslint .",
    "test": "node tools/art/cli.mjs && node --test tools/art/*.test.mjs && vitest run",
    "assets:build": "node tools/art/cli.mjs",
    "assets:test": "node --test tools/art/*.test.mjs",
    "assets:manifest": "node tools/art/reproducibility.mjs manifest",
    "assets:compare": "node tools/art/reproducibility.mjs compare"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
