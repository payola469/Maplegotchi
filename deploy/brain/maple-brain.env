# /etc/maple-brain/maple-brain.env — root:maple-brain-svc 0640. No secrets: the
# provider's login lives in /var/lib/maple-brain (the service's private state).

MAPLE_BRAIN_HOST=127.0.0.1
MAPLE_BRAIN_PORT=8471

# "none" answers "no proposal" (Maple then uses its rule fallbacks).
# "command" runs MAPLE_BRAIN_COMMAND: a JSON argv array, absolute path first, no shell.
# Copy the exact Antigravity CLI invocation from the existing server setup. The prompt
# is written to stdin and the answer read from stdout. Auto-approve / permission-bypass
# flags are refused at startup. "{model}" in an argument is replaced by MAPLE_BRAIN_MODEL.
MAPLE_BRAIN_PROVIDER=none
# MAPLE_BRAIN_COMMAND=["/usr/local/bin/REPLACE-WITH-PROVIDER-CLI", "REPLACE", "--model", "{model}"]
# MAPLE_BRAIN_MODEL=REPLACE-WITH-MODEL

# Per-endpoint timeouts (seconds); keep below Maple's (journal 30, director/replier 15).
MAPLE_BRAIN_GENERATE_TIMEOUT_SECONDS=25
MAPLE_BRAIN_DECIDE_TIMEOUT_SECONDS=12
MAPLE_BRAIN_REPLY_TIMEOUT_SECONDS=12
