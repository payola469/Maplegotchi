# /etc/maple-discord/maple-discord.env — root:maple-discord-svc 0640. No secrets here:
# the bot token and the gateway token are systemd credentials (see the unit's
# LoadCredential= lines and deploy/discord/README.md).

DISCORD_BOT_TOKEN_FILE=discord-bot-token
MAPLE_GATEWAY_TOKEN_FILE=maple-gateway-token

# Replace with real Discord ids (Developer Mode -> right click -> Copy ID).
MAPLE_DISCORD_GUILD_ID=REPLACE-WITH-SERVER-ID
MAPLE_DISCORD_CHANNEL_ID=REPLACE-WITH-maple-chat-CHANNEL-ID
MAPLE_DISCORD_OWNER_ID=REPLACE-WITH-PAOLO-USER-ID

MAPLE_API_URL=http://127.0.0.1:8470
