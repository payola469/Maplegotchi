# /etc/maplegotchi/maplegotchi.env — root:maple-svc 0640. Read by systemd at start.
# Maple cannot write this file (§4.1 #5). Change it only as the owner, then
# `systemctl restart maplegotchi`. Validated at startup (config.py): a
# non-loopback bind, fake senses, or a non-https origin refuse to start.

MAPLE_MODE=production
MAPLE_DATA_DIR=/data/maple
MAPLE_BIND_HOST=127.0.0.1
MAPLE_PORT=8470
MAPLE_STATIC_DIR=/opt/maplegotchi/current/frontend/dist
MAPLE_SENSES=paolo_core
MAPLE_MONITOR_DB=/data/monitor/metrics.db
MAPLE_HEARTBEAT_SECONDS=300

# The Tailscale Serve origin the browser sends with Greet/Pet. Replace the
# placeholder with paolo-core's MagicDNS name (no trailing dot), from:
#   tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'
MAPLE_ALLOWED_ORIGINS=https://paolo-core.REPLACE-ME.ts.net
